# লোকাল পোর্ট (শুধু লোকাল ডেভেলপমেন্টে, Vercel এটি নিজে ব্যবস্থাপনা করে)
PORT=3000
NODE_ENV=development

# নিচের কমান্ড চালিয়ে একটি র‍্যান্ডম সিক্রেট বানান এবং এখানে বসান:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# আপনার (লেখকের) নিজের bKash/মোবাইল নম্বর — সাইট থেকে "নতুন অ্যাকাউন্ট খুলুন" দিয়ে
# এই একই নম্বর দিয়ে রেজিস্টার করলেই সেই অ্যাকাউন্ট স্বয়ংক্রিয়ভাবে লেখক-অধিকার পাবে।
# অন্য কেউ (পাঠক) নিজের নম্বর দিয়ে রেজিস্টার করলে তারা শুধু পাঠক হিসেবেই থাকবে।
AUTHOR_PHONE=

# Turso ড্যাশবোর্ড থেকে পাওয়া যাবে (turso db show <db-name> এবং turso db tokens create <db-name>)
# খালি রাখলে লোকাল ফাইলে (local-dev.db) libSQL চলবে — শুধু লোকাল টেস্টের জন্য ভালো, Vercel-এ কাজ করবে না।
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- bKash "Send Money" (আপাতত মূল পদ্ধতি — merchant অ্যাকাউন্ট ছাড়াই কাজ করে) ---
# আপনার ব্যক্তিগত/এজেন্ট bKash নম্বর, পাঠকরা এখানে Send Money করবে
BKASH_SEND_MONEY_NUMBER=

# --- bKash Tokenized Checkout (ভবিষ্যতে merchant অ্যাকাউন্ট পেলে ব্যবহারের জন্য, এখনো সক্রিয় না) ---
# sandbox onboarding: https://developer.bka.sh
# প্রথমে sandbox মোডে টেস্ট করুন, প্রোডাকশনে গেলে BKASH_BASE_URL পাল্টে দিন।
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# আপনার লাইভ সাইটের সম্পূর্ণ URL (bKash callback-এর জন্য প্রয়োজন)।
# খালি রাখলে রিকোয়েস্টের host থেকে অনুমান করা হবে, কিন্তু production-এ স্পষ্টভাবে বসানো ভালো।
SITE_URL=
